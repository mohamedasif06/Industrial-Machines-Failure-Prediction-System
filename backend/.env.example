# Registered users are stored in this local, ignored SQLite file.
AUTH_DATABASE_PATH=instance/users.sqlite3

# Random server-side session expiry and cookie settings.
AUTH_SESSION_TTL_SECONDS=28800
# Keep false for local HTTP; set true only when serving over HTTPS.
AUTH_COOKIE_SECURE=false
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
